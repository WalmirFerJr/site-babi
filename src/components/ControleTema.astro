---
/**
 * Alternância de tema. O padrão é a preferência do sistema; a escolha explícita
 * é guardada em localStorage e vence a preferência a partir daí.
 *
 * O botão nasce com `hidden`: sem JavaScript não há como alternar nem como
 * lembrar a escolha, então não faz sentido mostrar um controle morto. O tema do
 * sistema continua valendo nesse caso, pelo script do <head>.
 */
interface Props {
  rotuloClaro: string;
  rotuloEscuro: string;
}
const { rotuloClaro, rotuloEscuro } = Astro.props;
---

<button
  type="button"
  class="tema"
  data-rotulo-claro={rotuloClaro}
  data-rotulo-escuro={rotuloEscuro}
  aria-pressed="false"
  hidden
>
  <span class="tema__icone" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="tema__sol" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" />
    </svg>
    <svg viewBox="0 0 24 24" class="tema__lua" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M20 13.4A8.4 8.4 0 0 1 10.6 4a8.4 8.4 0 1 0 9.4 9.4Z" />
    </svg>
  </span>
  <span class="visualmente-oculto tema__texto">{rotuloEscuro}</span>
</button>

<style>
  .tema {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition: color var(--duration) var(--ease), border-color var(--duration) var(--ease);
  }
  .tema:hover { color: var(--text); border-color: var(--text-muted); }

  .tema__icone { display: grid; place-items: center; width: 1.15rem; height: 1.15rem; }
  .tema__icone > svg { grid-area: 1 / 1; width: 100%; height: 100%; }

  /* O ícone mostra o tema que será aplicado ao clicar, não o atual. */
  .tema__sol { display: none; }
  :global([data-tema='escuro']) .tema__sol { display: block; }
  :global([data-tema='escuro']) .tema__lua { display: none; }
</style>
