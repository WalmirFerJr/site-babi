---
import { Picture } from 'astro:assets';
import type { Idioma } from '../i18n';
import { t } from '../i18n';
import { perfil, obterRetrato, temCases } from '../data/conteudo';
import MarcaEditorial from './MarcaEditorial.astro';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const d = t(idioma);
const hero = d.hero;
const retrato = obterRetrato(idioma);

const ctaTexto = temCases ? hero.ctaPrincipalComCases : hero.ctaPrincipal;
const ctaHref = temCases ? '#trabalhos' : '#trajetoria';
---

<section class="hero" id="inicio">
  <div class="container hero__grade">
    <div class="hero__texto">
      <p class="hero__sobretitulo">
        <MarcaEditorial class="hero__asterisco" />
        <span class="hero__nome">{perfil.name}</span>
        <span class="hero__barra" aria-hidden="true">/</span>
        <span>{hero.sobretitulo}</span>
      </p>

      <h1 class="hero__titulo">
        {hero.titulo.map((linha) => <span class="hero__linha">{linha}</span>)}
      </h1>

      <p class="hero__apoio">{hero.apoio}</p>

      <div class="hero__acoes">
        <a class="botao botao--principal" href={ctaHref}>
          {ctaTexto}
          <span class="seta" aria-hidden="true">→</span>
        </a>
        <a class="botao botao--secundario" href={`mailto:${perfil.email}`}>
          {hero.ctaSecundario}
        </a>
      </div>
    </div>

    <!--
      Área visual. Com retrato cadastrado no manifesto, ele entra aqui; sem retrato,
      a composição abstrata do kit segura o lugar — decorativa, sem silhueta fictícia.
    -->
    <div class="hero__visual">
      {retrato ? (
        <figure class="hero__retrato">
          <Picture
            src={retrato.src}
            alt={retrato.alt}
            widths={[320, 520, 800]}
            sizes="(min-width: 62em) 25rem, (min-width: 48em) 50vw, 80vw"
            loading="eager"
            fetchpriority="high"
            formats={['avif', 'webp']}
            class="hero__foto"
          />
          {retrato.credito && <figcaption class="hero__credito">Foto: {retrato.credito}.</figcaption>}
        </figure>
      ) : (
      <svg
        class="hero__composicao"
        viewBox="0 0 600 720"
        role="presentation"
        aria-hidden="true"
        focusable="false"
      >
        <rect width="600" height="720" fill="var(--surface)" />
        <path d="M90 570V245a180 180 0 0 1 360 0v325Z" fill="#dda15e" />
        <circle cx="322" cy="320" r="144" fill="#606c38" />
        <path d="M165 575V370a114 114 0 0 1 228 0v205Z" fill="#283618" />
        <circle cx="432" cy="150" r="75" fill="#bc6c25" />
        <path d="M40 640H560M40 664H400" stroke="#606c38" stroke-width="2" />
        <g stroke="#fefae0" stroke-width="7" stroke-linecap="round">
          <path d="M287 385v72m-31-54 62 36m-62 0 62-36" />
        </g>
      </svg>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 1.5rem + 6vw, 6rem) clamp(3.5rem, 2rem + 6vw, 6.5rem);
    overflow: hidden;
  }

  /* Filete terracota discreto fechando o hero. */
  .hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(
      to right,
      var(--accent) 0 22%,
      var(--rule) 22% 100%
    );
  }

  .hero__grade {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .hero__sobretitulo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero__asterisco { width: 1.15em; height: 1.15em; }
  .hero__nome { color: var(--text); }
  .hero__barra { color: var(--text-muted); }

  .hero__titulo {
    /* Terracota em texto grande (>=48px) atende AA para texto grande sobre creme. */
    margin-block-end: var(--space-3);
  }
  .hero__linha { display: block; }
  .hero__linha:last-child { color: var(--accent); }

  .hero__apoio {
    max-width: 48ch;
    margin-block-end: var(--space-4);
    font-size: var(--step-lead);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero__visual {
    /* Bastante respiro: a composição não encosta nas bordas do bloco. */
    display: grid;
    place-items: center;
    padding: clamp(0.5rem, 3vw, 2rem);
  }

  .hero__composicao {
    width: 100%;
    max-width: 22rem;
    height: auto;
    border-radius: var(--radius);
  }

  .hero__retrato { margin: 0; width: 100%; max-width: 22rem; }
  .hero__retrato :global(picture) { display: block; }

  .hero__foto {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    /* Sem filtro: a foto mantém cor e textura naturais. */
  }

  .hero__credito {
    margin-block-start: 0.6rem;
    font-size: var(--step-small);
    color: var(--text-muted);
  }

  @media (min-width: 62em) {
    .hero__grade {
      /* Headline ocupa ~60% da largura, como na direção de arte. */
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
    .hero__composicao,
    .hero__retrato { max-width: 25rem; }
  }
</style>
