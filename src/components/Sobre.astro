---
import type { Idioma } from '../i18n';
import { t } from '../i18n';
import { obterCompetencias, obterFerramentas, obterFormacao, obterIdiomas } from '../data/conteudo';
import RotuloSecao from './RotuloSecao.astro';
import MarcaEditorial from './MarcaEditorial.astro';

interface Props { numero?: string; idioma: Idioma }
const { numero, idioma } = Astro.props;
const sobre = t(idioma).sobre;

const competencias = obterCompetencias(idioma);
const ferramentas = obterFerramentas(idioma);
const idiomas = obterIdiomas(idioma);
/** Derivada de perfil.json para não divergir do currículo quando a formação mudar. */
const formacao = obterFormacao(idioma, sobre.conclusaoPrevista);
---

<section class="secao secao-sobre" id="sobre" aria-labelledby="titulo-sobre">
  <div class="container sobre__grade">
    <div class="sobre__principal">
      <RotuloSecao numero={numero} texto={sobre.rotulo} />
      <h2 class="sobre__titulo" id="titulo-sobre">{sobre.titulo}</h2>

      <div class="sobre__texto">
        {sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
      </div>

      <p class="sobre__acoes">
        <!-- O PDF é copiado por scripts/sync-conteudo.mjs. Só o e-mail aparece na página; o telefone fica no PDF. -->
        <a class="botao botao--secundario" href="/curriculo/barbara-fraquete.pdf" download>
          {sobre.curriculo}
          <span class="sobre__formato" aria-hidden="true">{sobre.curriculoFormato}</span>
          <span class="visualmente-oculto">({sobre.curriculoArquivo} {sobre.curriculoFormato})</span>
        </a>
      </p>
    </div>

    <!--
      Quando chegar o retrato secundário, ele entra aqui (ver LEIA-ME.md).
      Até lá, a coluna é uma ficha tipográfica limpa, sem foto genérica.
    -->
    <aside class="sobre__ficha" aria-label={sobre.fichaRotulo}>
      <MarcaEditorial class="sobre__marca" />

      <div class="sobre__campo">
        <h3 class="sobre__rotulo">{sobre.rotulos.formacao}</h3>
        <p class="sobre__valor">{formacao}</p>
      </div>

      <div class="sobre__campo">
        <h3 class="sobre__rotulo">{sobre.rotulos.competencias}</h3>
        <ul class="sobre__tags">
          {competencias.map((competencia) => <li class="sobre__tag">{competencia}</li>)}
        </ul>
      </div>

      <div class="sobre__campo">
        <h3 class="sobre__rotulo">{sobre.rotulos.ferramentas}</h3>
        <p class="sobre__valor">{ferramentas.join(' · ')}</p>
      </div>

      {idiomas && (
        <div class="sobre__campo">
          <h3 class="sobre__rotulo">{sobre.rotulos.idioma}</h3>
          <p class="sobre__valor">{idiomas}</p>
        </div>
      )}
    </aside>
  </div>
</section>

<style>
  .sobre__grade {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .sobre__titulo {
    margin-block: var(--space-3) var(--space-3);
    max-width: 18ch;
  }

  .sobre__texto {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .sobre__acoes { margin-block-start: var(--space-4); }

  .sobre__formato {
    padding: 0.1rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-forest);
    background-color: var(--color-sand);
    border-radius: var(--radius-sm);
  }
  /* No tema escuro o botão fica creme ao passar o mouse; um selo creme sumiria
     dentro dele. A areia mantém o selo legível nos dois temas. */

  .sobre__ficha {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.5rem, 3vw, 2rem);
    background-color: var(--surface-invert);
    color: var(--on-invert-text);
    border-radius: var(--radius);
  }

  .sobre__marca {
    position: absolute;
    top: -0.9rem;
    right: 1.25rem;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-sand);
  }

  .sobre__rotulo {
    font-family: var(--font-display);
    font-size: var(--step-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-invert-muted);
  }

  .sobre__valor {
    margin-block-start: 0.4rem;
    font-size: var(--step-small);
    line-height: 1.55;
    color: var(--on-invert-text);
  }

  .sobre__campo + .sobre__campo {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule-invert);
  }

  .sobre__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .sobre__tag {
    padding: 0.3rem 0.7rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--on-invert-text);
    border: 1px solid color-mix(in srgb, var(--color-sand) 55%, transparent);
    border-radius: 999px;
  }

  @media (min-width: 62em) {
    .sobre__grade { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); }
    .sobre__ficha { position: sticky; top: 6rem; }
  }
</style>
