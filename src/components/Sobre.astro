---
import { sobre } from '../data/textos';
import { perfil } from '../data/conteudo';
import RotuloSecao from './RotuloSecao.astro';
import MarcaEditorial from './MarcaEditorial.astro';

interface Props { numero?: string }
const { numero } = Astro.props;

const idiomas = perfil.languages.map((i) => `${i.language} ${i.level.toLowerCase()}`).join(' · ');

/** Derivada de perfil.json para não divergir do currículo quando a formação mudar. */
const { degree, institution, expectedEnd } = perfil.education;
const formacao = `${degree} · ${institution} · conclusão prevista em ${expectedEnd.slice(0, 4)}.`;
---

<section class="secao secao-sobre" id="sobre" aria-labelledby="titulo-sobre">
  <div class="container sobre__grade">
    <div class="sobre__principal">
      <RotuloSecao numero={numero} texto="Sobre" />
      <h2 class="sobre__titulo" id="titulo-sobre">{sobre.titulo}</h2>

      <div class="sobre__texto">
        {sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
      </div>

      <p class="sobre__acoes">
        <!-- O PDF é copiado por scripts/sync-conteudo.mjs. Só o e-mail aparece na página; o telefone fica no PDF. -->
        <a class="botao botao--secundario" href={sobre.curriculo.href} download>
          {sobre.curriculo.texto}
          <span class="sobre__formato" aria-hidden="true">{sobre.curriculo.complemento}</span>
          <span class="visualmente-oculto">(arquivo {sobre.curriculo.complemento})</span>
        </a>
      </p>
    </div>

    <!--
      Quando chegar o retrato secundário, ele entra aqui (ver LEIA-ME.md).
      Até lá, a coluna é uma ficha tipográfica limpa, sem foto genérica.
    -->
    <aside class="sobre__ficha" aria-label="Formação, ferramentas e idiomas">
      <MarcaEditorial class="sobre__marca" />

      <div class="sobre__campo">
        <h3 class="sobre__rotulo">{sobre.rotulos.formacao}</h3>
        <p class="sobre__valor">{formacao}</p>
      </div>

      <div class="sobre__campo">
        <h3 class="sobre__rotulo">Competências</h3>
        <ul class="sobre__tags">
          {perfil.skills.map((competencia) => <li class="sobre__tag">{competencia}</li>)}
        </ul>
      </div>

      <div class="sobre__campo">
        <h3 class="sobre__rotulo">{sobre.rotulos.ferramentas}</h3>
        <p class="sobre__valor">{perfil.tools.join(' · ')}</p>
      </div>

      {idiomas && (
        <div class="sobre__campo">
          <h3 class="sobre__rotulo">{sobre.rotulos.idioma}</h3>
          <p class="sobre__valor">{idiomas}</p>
        </div>
      )}
    </aside>
  </div>
</section>

<style>
  .sobre__grade {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .sobre__titulo {
    margin-block: var(--space-3) var(--space-3);
    max-width: 18ch;
  }

  .sobre__texto {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    font-size: var(--step-lead);
    line-height: 1.6;
    color: var(--color-olive);
  }

  .sobre__acoes { margin-block-start: var(--space-4); }

  .sobre__formato {
    padding: 0.1rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-forest);
    background-color: var(--color-sand);
    border-radius: var(--radius-sm);
  }
  .botao--secundario:hover .sobre__formato { background-color: var(--color-cream); }

  .sobre__ficha {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.5rem, 3vw, 2rem);
    background-color: var(--color-forest);
    color: var(--color-cream);
    border-radius: var(--radius);
  }

  .sobre__marca {
    position: absolute;
    top: -0.9rem;
    right: 1.25rem;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-terracotta);
  }

  .sobre__rotulo {
    font-family: var(--font-display);
    font-size: var(--step-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* Areia sobre floresta: 5,72:1. */
    color: var(--color-sand);
  }

  .sobre__valor {
    margin-block-start: 0.4rem;
    font-size: var(--step-small);
    line-height: 1.55;
    color: var(--color-cream);
  }

  .sobre__campo + .sobre__campo {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid color-mix(in srgb, var(--color-sand) 35%, transparent);
  }

  .sobre__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .sobre__tag {
    padding: 0.3rem 0.7rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-cream);
    border: 1px solid color-mix(in srgb, var(--color-sand) 55%, transparent);
    border-radius: 999px;
  }

  @media (min-width: 62em) {
    .sobre__grade { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); }
    .sobre__ficha { position: sticky; top: 6rem; }
  }
</style>
