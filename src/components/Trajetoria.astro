---
import { trajetoria } from '../data/textos';
import { experiencias } from '../data/conteudo';
import RotuloSecao from './RotuloSecao.astro';

interface Props { numero?: string }
const { numero } = Astro.props;

/**
 * Cargos nunca são fundidos: os dois vínculos na Digipix aparecem como entradas
 * distintas. A repetição do empregador só muda o agrupamento visual.
 */
const entradas = experiencias.map((experiencia, indice) => ({
  ...experiencia,
  agrupada: indice > 0 && experiencias[indice - 1]!.company === experiencia.company,
}));
---

<section class="secao secao-trajetoria" id="trajetoria" aria-labelledby="titulo-trajetoria">
  <div class="container">
    <RotuloSecao numero={numero} texto="Trajetória" />

    <div class="trajetoria__abertura">
      <h2 id="titulo-trajetoria">{trajetoria.titulo}</h2>
      <p class="trajetoria__intro">{trajetoria.intro}</p>
    </div>

    <ol class="trajetoria__lista">
      {entradas.map((entrada) => (
        <li class="trajetoria__item" data-agrupada={String(entrada.agrupada)}>
          <div class="trajetoria__periodo">
            <span class="trajetoria__datas">{entrada.period}</span>
            {entrada.current && <span class="trajetoria__atual">Atual</span>}
          </div>

          <div class="trajetoria__corpo">
            <h3 class="trajetoria__cargo">{entrada.role}</h3>
            {/* Empresas em texto até que logos oficiais sejam enviados. */}
            <p class="trajetoria__empresa">{entrada.company}</p>

            {entrada.keywords && entrada.keywords.length > 0 && (
              <ul class="trajetoria__chaves">
                {entrada.keywords.map((chave) => <li>{chave}</li>)}
              </ul>
            )}

            <ul class="trajetoria__atividades" data-marcadores>
              {entrada.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .trajetoria__abertura {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-3) clamp(2rem, 4vw, 3rem);
  }
  .trajetoria__abertura h2 { max-width: 20ch; }
  .trajetoria__intro {
    max-width: var(--measure);
    font-size: var(--step-lead);
    color: var(--color-olive);
  }

  .trajetoria__lista {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: nenhum;
  }

  .trajetoria__item {
    display: grid;
    gap: var(--space-2);
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-block-start: 1px solid var(--rule);
  }
  /* Entradas do mesmo empregador ficam visualmente ligadas por um filete mais leve. */
  .trajetoria__item[data-agrupada='true'] {
    border-block-start-style: dashed;
    border-block-start-color: color-mix(in srgb, var(--color-olive) 22%, transparent);
  }
  .trajetoria__item:last-child { border-block-end: 1px solid var(--rule); }

  .trajetoria__periodo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }

  .trajetoria__datas {
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-olive);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Estado "atual" tem texto próprio, não depende só de cor. */
  .trajetoria__atual {
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-forest);
    background-color: var(--color-sand);
    border-radius: 999px;
  }

  .trajetoria__cargo {
    font-size: var(--step-h3);
    color: var(--color-forest);
  }

  .trajetoria__empresa {
    margin-block-start: 0.15rem;
    font-family: var(--font-display);
    /* 20px em peso 700 conta como texto grande: terracota sobre creme (3,76:1)
       cumpre o mínimo de 3:1. Abaixo disso a combinação não seria permitida. */
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-terracotta);
  }

  /* Faixa de palavras-chave do cargo, no espírito das tarjas do currículo. */
  .trajetoria__chaves {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    margin-block-start: 0.5rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-olive);
  }
  .trajetoria__chaves li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .trajetoria__chaves li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-terracotta);
  }

  .trajetoria__atividades {
    display: grid;
    gap: 0.625rem;
    margin-block-start: var(--space-2);
    max-width: var(--measure);
    padding-inline-start: 1.1rem;
    color: var(--color-olive);
    line-height: 1.6;
  }
  .trajetoria__atividades li { padding-inline-start: 0.35rem; }
  .trajetoria__atividades li::marker { color: var(--color-terracotta); }

  @media (min-width: 48em) {
    .trajetoria__item {
      grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
      gap: var(--space-4);
    }
    .trajetoria__periodo {
      flex-direction: column;
      align-items: flex-start;
      padding-block-start: 0.3rem;
    }
  }

  @media (min-width: 75em) {
    .trajetoria__item { grid-template-columns: minmax(12rem, 14rem) minmax(0, 1fr); }
  }
</style>
