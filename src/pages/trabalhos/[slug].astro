---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PaginaCase from '../../components/PaginaCase.astro';
import type { CasePublicado } from '../../data/conteudo';
import { obterCases, perfil } from '../../data/conteudo';

/**
 * Uma rota por case publicado, com URL legível.
 * Rascunhos não entram: com zero cases publicados, nenhuma rota é gerada.
 */
export const getStaticPaths: GetStaticPaths = () =>
  obterCases('pt').map((caso) => ({ params: { slug: caso.slug }, props: { caso } }));

interface Props { caso: CasePublicado }
const { caso } = Astro.props;
---

<Base
  idioma="pt"
  caminho={`/trabalhos/${caso.slug}`}
  titulo={`${caso.title} | ${perfil.name}`}
  descricao={caso.context ?? `${caso.title}, projeto de ${perfil.name}.`}
>
  <PaginaCase caso={caso} idioma="pt" />
</Base>
